# Salin menjadi .env. Jangan kirim token/password ke chat atau Git.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=crypto_signal_bot
DB_USER=crypto_signal_bot
DB_PASSWORD=

PREFECT_API_URL=http://127.0.0.1:4200/api
PREFECT_SERVER_DATABASE_CONNECTION_URL=postgresql+asyncpg://prefect_bot:CHANGE_ME@127.0.0.1:5433/prefect_bot
PREFECT_SERVER_ANALYTICS_ENABLED=false
PREFECT_SERVER_EPHEMERAL_ENABLED=false
PREFECT_API_DATABASE_MIGRATE_ON_START=true

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
AI_PROVIDER=ollama
# hermes: gunakan profil lokal dari hermes-config.yaml setelah setup_local.py hermes.
HERMES_EXECUTABLE=
HERMES_TIMEOUT_SECONDS=180
AI_TIMEOUT_SECONDS=120
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# false: simulasi lokal; true: izinkan pengiriman sinyal simulasi ke chat Anda.
TELEGRAM_ENABLED=false

BINANCE_URL=https://fapi.binance.com
UNIVERSE_SIZE=50
MIN_QUOTE_VOLUME=20000000
MIN_LISTING_DAYS=30
MIN_RELATIVE_VOLUME=1.2
MIN_TAKER_IMBALANCE=0.05
MAX_SPREAD_BPS=8
MAX_FUNDING_RATE=0.001
MIN_REWARD_RISK=2
FEE_BPS=5
SLIPPAGE_BPS=3
MAX_OPEN_SIGNALS=3
ENTRY_VALID_MINUTES=10
MAX_HOLD_HOURS=24
EVALUATION_MIN_SAMPLES=20
# Evaluasi setiap menit. Scan candle 15m mulai dua menit setelah candle close.
